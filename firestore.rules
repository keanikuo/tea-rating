rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function sess(code) { return get(/databases/$(database)/documents/sessions/$(code)).data; }
    function isHostOf(code) { return sess(code).hostUid == request.auth.uid; }

    match /sessions/{code} {
      // 有代碼的人都能讀場次資訊（名稱、杯數、製作日期）
      allow get: if signedIn();
      allow list: if false;
      // 建立場次的人就是主揪
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.cups is int
        && request.resource.data.cups <= 60;
      // 只有主揪能改（加杯、填日期、揭曉）
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.cups <= 60;
      // 只有主揪能刪除場次
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      // 參加名單與進度：場次裡的人都看得到，只能改自己的；主揪刪場次時可一起刪
      match /members/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || isHostOf(code));
      }

      // 評分：揭曉前只看得到自己的，揭曉後大家都看得到；主揪刪場次時可一起刪
      match /players/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || sess(code).revealed == true);
        allow list: if signedIn() && sess(code).revealed == true;
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || isHostOf(code));
      }
    }
  }
}
